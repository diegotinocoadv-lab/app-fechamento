# ==========================================================
# Variáveis de ambiente para deploy na VPN
# Copie para .env.production e preencha. NÃO comite esse arquivo.
# ==========================================================

# --- Servidor ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# URL pública do app (domínio ou IP da VPN)
APP_URL=https://SEU_DOMINIO

# --- Banco de dados / Backend (Supabase) ---
# Lado servidor
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta: só no servidor, nunca no cliente
SUPABASE_SERVICE_ROLE_KEY=

# Lado cliente (embutidas no build — passe como build args)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=seu_project_id

# --- E-mail (envio do fechamento) ---
EMAIL_TO=diego.tinoco.adv@gmail.com
EMAIL_FROM=fechamento@SEU_DOMINIO
# Se usar SMTP próprio na VPN:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Se continuar usando o e-mail gerenciado do Lovable:
LOVABLE_API_KEY=
